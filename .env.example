# Copy this file to `.env` and fill in real values for local development.
# NEVER commit a real `.env` file.

ENVIRONMENT=development
DEBUG=true

# Async SQLAlchemy URL. When running via `docker compose up`, the `api`
# service overrides this to point at the `db` service automatically — this
# value is what host-side tooling (alembic, pytest run outside Docker) uses.
DATABASE_URL=postgresql+asyncpg://linkedout:linkedout@localhost:5432/linkedout

# JWT signing secret. Generate a real one for anything beyond local dev, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# HMAC pepper for hashing PII (phone numbers, later corporate emails/doc
# IDs) before it is ever persisted. Generate a real one the same way as
# JWT_SECRET, keep it out of source control, and never rotate it without a
# migration plan (rotating it invalidates every existing phone_hash lookup).
PII_HASH_PEPPER=dev-only-insecure-pepper-change-me

# CORS: comma-separated list of allowed frontend origins. `*` (the
# default) is fine for local dev only. A real deployment MUST set this to
# the exact origin(s) the frontend is served from, e.g.:
#   CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=*

# Rate limits for public-ish write endpoints (Phase 5) — see
# app/core/rate_limit.py and TRUST_ARCHITECTURE.md. Sensible defaults are
# baked into app/core/config.py; only set these if you need to override
# them for a specific deployment.
# REVIEW_RATE_LIMIT_MAX_REQUESTS=5
# REVIEW_RATE_LIMIT_WINDOW_MINUTES=60
# GRIEVANCE_RATE_LIMIT_MAX_REQUESTS=5
# GRIEVANCE_RATE_LIMIT_WINDOW_MINUTES=60
